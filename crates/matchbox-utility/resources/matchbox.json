/**
 * MatchBox runtime configuration.
 *
 * Follows the BoxLang boxlang.json spec. Keys MatchBox does not support yet are ignored.
 * Placeholders: ${matchbox-home} is the MatchBox home, ${user-dir} is the working directory.
 */
{
	// When true the root log level is raised to DEBUG
	"debugMode": false,
	// Logging settings for the runtime
	"logging": {
		// The location of the log files the runtime will produce
		"logsDirectory": "${matchbox-home}/logs",
		// The maximum number of days to keep rotated log files. 0 never deletes them
		"maxLogDays": 90,
		// The maximum size of a single log file before rotation (KB, MB, GB)
		"maxFileSize": "100MB",
		// The total cap size of all log files (KB, MB, GB). Oldest rotated files are deleted first
		"totalCapSize": "5GB",
		// ERROR, WARN, INFO, DEBUG, TRACE or OFF
		"rootLevel": "WARN",
		// Encoder for the log file: "text" or "json"
		"defaultEncoder": "text"
	}
}
