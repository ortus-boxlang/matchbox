/**
 * MatchBox Standard Library (Prelude)
 */

// --- Math BIFs ---

// --- Array BIFs ---

/**
 * Converts an array to a string using a delimiter.
 */
function arrayToList(array, delimiter = ",") {
    var result = "";
    var first = true;
    for (item in array) {
        if (!first) {
            result = result & delimiter;
        }
        result = result & item;
        first = false;
    }
    return result;
}

/**
 * Returns a new array with the elements in reverse order.
 */
function arrayReverse(array) {
    var result = [];
    var length = len(array);
    for (var i = length; i >= 1; i--) {
        arrayAppend(result, array[i]);
    }
    return result;
}

/**
 * Returns a slice of an array.
 */
function arraySlice(array, start = 1, length = 0) {
    var result = [];
    var size = len(array);
    var from = start - 1;
    if (from < 0) {
        from = size + start;
    }
    var count = length;
    if (count < 0) {
        count = (size + count) - from;
    } else if (count == 0) {
        count = size - from;
    }
    for (var i = from; i < from + count; i++) {
        if (i < size) {
            arrayAppend(result, array[i + 1]);
        }
    }
    return result;
}

/**
 * Returns the first element of an array.
 */
function arrayFirst(array, defaultValue = null) {
    if (len(array) == 0) {
        return defaultValue;
    }
    return array[1];
}

/**
 * Returns the last element of an array.
 */
function arrayLast(array, defaultValue = null) {
    var length = len(array);
    if (length == 0) {
        return defaultValue;
    }
    return array[length];
}

/**
 * Finds the index of a value in an array. Returns 0 if not found.
 */
function arrayFind(array, value) {
    var length = len(array);
    for (var i = 1; i <= length; i++) {
        if (_arrayValueEquals(array[i], value)) {
            return i;
        }
    }
    return 0;
}

/**
 * Returns the sum of values in an array.
 */
function arraySum(array) {
    var sum = 0;
    for (item in array) {
        sum = sum + item;
    }
    return sum;
}

/**
 * Returns the average of values in an array.
 */
function arrayAvg(array) {
    var length = len(array);
    if (length == 0) {
        return 0;
    }
    return arraySum(array) / length;
}

/**
 * Returns the minimum value in an array.
 */
function arrayMin(array) {
    var length = len(array);
    if (length == 0) {
        return null;
    }
    var result = array[1];
    for (item in array) {
        if (item < result) {
            result = item;
        }
    }
    return result;
}

/**
 * Returns the maximum value in an array.
 */
function arrayMax(array) {
    var length = len(array);
    if (length == 0) {
        return null;
    }
    var result = array[1];
    for (item in array) {
        if (item > result) {
            result = item;
        }
    }
    return result;
}

/**
 * Deletes a specific value from an array.
 */
function arrayDelete(array, value, scope = "one") {
    var removed = false;
    if (scope == "all") {
        var i = len(array);
        while (i >= 1) {
            if (_arrayValueEquals(array[i], value)) {
                arrayDeleteAt(array, i);
                removed = true;
            }
            i = i - 1;
        }
    } else {
        var index = arrayFind(array, value);
        if (index > 0) {
            arrayDeleteAt(array, index);
            removed = true;
        }
    }
    return removed;
}

/**
 * Returns an array containing only unique values.
 *
 * O(n) for primitive values (numbers, strings, booleans, null) using a
 * backing struct as a hash set — `structKeyExists` is O(1).
 *
 * Equality follows the VM's `==` operator:
 *   - numbers compare by value (1 == 1.0)
 *   - strings compare case-insensitively ("Foo" == "foo")
 *   - booleans, null compare by value
 *   - other values (datetimes, bytes, arrays, structs, …) are deduplicated
 *     by value where the VM's `==` defines value equality, using a linear
 *     scan over previously-seen non-primitive items. That linear scan only
 *     runs for non-primitive items, so the common primitive case stays O(n).
 *
 * Type discrimination uses only true-type-check BIFs (`isNull`, `isString`)
 * plus `isSimpleValue`, so a parseable string like "1" is never mistaken for
 * the number 1 (unlike `isNumeric`, which would conflate them).
 */
function arrayUnique(array) {
    var result = [];
    var seenKeys = {};
    var complexItems = [];
    var length = len(array);

    for (var i = 1; i <= length; i++) {
        var item = array[i];
        var key = "";
        var isPrimitive = true;

        if (isNull(item)) {
            key = "z:null";
        } else if (isString(item)) {
            key = "s:" & lcase(item);
        } else if (isSimpleValue(item) && isNumeric(item)) {
            // Reached only for genuine numbers (strings were caught above).
            // Guard NaN: NaN != NaN, so two NaNs must NOT collapse.
            if (item != item) {
                isPrimitive = false;
            } else {
                key = "n:" & (item & "");
            }
        } else if (isSimpleValue(item)) {
            // Remaining simple values: booleans (datetimes are rare and use
            // value equality, so route them through the complex bucket).
            // Distinguish bool from datetime by string form: bools render as
            // "true"/"false", datetimes as ISO-8601.
            var render = item & "";
            if (render == "true" || render == "false") {
                key = "b:" & render;
            } else {
                isPrimitive = false;
            }
        } else {
            isPrimitive = false;
        }

        if (isPrimitive) {
            if (!structKeyExists(seenKeys, key)) {
                structInsert(seenKeys, key, true);
                arrayAppend(result, item);
            }
        } else {
            // Non-primitive: rely on VM `==` for value equality (datetimes,
            // bytes) and identity for the rest, scanning only the previously
            // seen non-primitive items — bounded and rare in practice.
            var alreadySeen = false;
            var complexLen = len(complexItems);
            for (var c = 1; c <= complexLen; c++) {
                if (complexItems[c] == item) {
                    alreadySeen = true;
                    break;
                }
            }
            if (!alreadySeen) {
                arrayAppend(complexItems, item);
                arrayAppend(result, item);
            }
        }
    }
    return result;
}

/**
 * Finds the index of a value in an array (case-insensitive).
 */
function arrayFindNoCase(array, value) {
    var length = len(array);
    for (var i = 1; i <= length; i++) {
        if (_arrayValueEqualsNoCase(array[i], value)) {
            return i;
        }
    }
    return 0;
}

/**
 * Deletes a value from an array using case-insensitive string equality.
 */
function arrayDeleteNoCase(array, value, scope = "one") {
    var removed = false;
    if (scope == "all") {
        var i = len(array);
        while (i >= 1) {
            if (_arrayValueEqualsNoCase(array[i], value)) {
                arrayDeleteAt(array, i);
                removed = true;
            }
            i = i - 1;
        }
    } else {
        var index = arrayFindNoCase(array, value);
        if (index > 0) {
            arrayDeleteAt(array, index);
            removed = true;
        }
    }
    return removed;
}

/**
 * Sorts an array in place using an O(n log n) stable merge sort.
 *
 * `sortType` ("text"|"numeric") and `sortOrder` ("asc"|"desc") control
 * ordering. Comparisons reuse the VM's `<` / `>` operators so that numbers,
 * datetimes, and strings all sort exactly as they did under the previous
 * bubble-sort implementation — only the algorithmic complexity changes.
 *
 * Returns the sorted array and mutates the input array.
 */
function arraySort(array, sortType = "text", sortOrder = "asc") {
    var length = len(array);
    if (length < 2) {
        return array;
    }

    // Work on a slice rather than the live array during the merge passes;
    // copy back into `array` at the end so the caller sees the sorted result.
    var work = arraySlice(array, 1, length);

    var width = 1;
    while (width < length) {
        var merged = [];
        var i = 1;
        var doubledWidth = width * 2;
        while (i <= length) {
            var leftEnd = i + width - 1;
            if (leftEnd > length) {
                leftEnd = length;
            }
            var rightStart = leftEnd + 1;
            var rightEnd = rightStart + width - 1;
            if (rightEnd > length) {
                rightEnd = length;
            }

            if (rightStart > length) {
                // No right run — copy the remainder verbatim.
                for (var k = i; k <= leftEnd; k++) {
                    arrayAppend(merged, work[k]);
                }
            } else {
                var l = i;
                var r = rightStart;
                while (l <= leftEnd && r <= rightEnd) {
                    if (_sortShouldComeBefore(work[l], work[r], sortType, sortOrder)) {
                        arrayAppend(merged, work[l]);
                        l = l + 1;
                    } else {
                        arrayAppend(merged, work[r]);
                        r = r + 1;
                    }
                }
                while (l <= leftEnd) {
                    arrayAppend(merged, work[l]);
                    l = l + 1;
                }
                while (r <= rightEnd) {
                    arrayAppend(merged, work[r]);
                    r = r + 1;
                }
            }
            i = i + doubledWidth;
        }
        work = merged;
        width = doubledWidth;
    }

    // Copy the sorted run back into the caller's array in place.
    for (var n = 1; n <= length; n++) {
        array[n] = work[n];
    }
    return array;
}

/**
 * Adds a value to the end of an array. Returns the new size.
 */
function arrayPush(array, value) {
    arrayAppend(array, value);
    return len(array);
}

/**
 * Returns true if the given 1-based index exists and is not null.
 */
function arrayIndexExists(array, index) {
    var idx = index;
    if (idx < 1 || idx > len(array)) {
        return false;
    }
    return !isNull(array[idx]);
}

/**
 * Removes and returns the first element.
 */
function arrayShift(array, defaultValue) {
    if (len(array) == 0) {
        if (!isNull(defaultValue)) {
            return defaultValue;
        }
        throw "arrayShift() cannot shift an empty array";
    }
    var value = array[1];
    arrayDeleteAt(array, 1);
    return value;
}

/**
 * Adds a value to the beginning of an array. Returns the new size.
 */
function arrayUnshift(array, value) {
    arrayInsertAt(array, 1, value);
    return len(array);
}

/**
 * Merges two arrays.
 */
function arrayMerge(array1, array2, leaveIndex = false) {
    var result = [];
    if (leaveIndex) {
        if (len(array1) >= len(array2)) {
            for (var i = 1; i <= len(array1); i++) {
                result[i] = array1[i];
            }
        } else {
            for (var i = 1; i <= len(array2); i++) {
                result[i] = array2[i];
            }
            for (var i = 1; i <= len(array1); i++) {
                result[i] = array1[i];
            }
        }
        return result;
    }
    for (var item in array1) {
        arrayAppend(result, item);
    }
    for (var item in array2) {
        arrayAppend(result, item);
    }
    return result;
}

/**
 * Creates an array of numbers in a range (inclusive).
 */
function arrayRange(start = 1, end, count = null) {
    if (isNull(end)) {
        end = start;
    }
    if (isString(start)) {
        var str = toString(start);
        var dotPos = find("..", str);
        if (dotPos > 0) {
            var fromStr = left(str, dotPos - 1);
            if (len(fromStr) == 0 || !isNumeric(fromStr)) {
                throw "arrayRange() invalid start";
            }
            start = val(fromStr);
            var endCount = len(str) - dotPos - 1;
            if (endCount == 0) {
                end = start;
            } else {
                var toStr = right(str, endCount);
                if (!isNumeric(toStr)) {
                    throw "arrayRange() invalid end";
                }
                end = val(toStr);
            }
        } else {
            if (!isNumeric(str)) {
                throw "arrayRange() invalid range";
            }
            start = val(str);
            end = start;
        }
    }
    if (isString(end)) {
        if (!isNumeric(end)) {
            throw "arrayRange() invalid end";
        }
        end = val(end);
    }
    if (!isNumeric(start) || !isNumeric(end)) {
        throw "arrayRange() expects numeric bounds";
    }
    if (!isNull(count) && (!isNumeric(count) || count <= 0)) {
        throw "arrayRange() count must be greater than zero";
    }
    if (end < start) {
        end = start;
    }
    var result = [];
    for (var i = start; i <= end; i++) {
        arrayAppend(result, i);
    }
    return result;
}

/**
 * Splits an array into chunks of the given size.
 */
function arrayChunk(array, chunkSize) {
    if (!isNumeric(chunkSize) || chunkSize <= 0) {
        throw "arrayChunk() chunk size must be greater than zero";
    }
    var result = [];
    var length = len(array);
    var i = 1;
    while (i <= length) {
        var chunk = [];
        var end = i + chunkSize - 1;
        if (end > length) {
            end = length;
        }
        for (var j = i; j <= end; j++) {
            arrayAppend(chunk, array[j]);
        }
        arrayAppend(result, chunk);
        i = i + chunkSize;
    }
    return result;
}

/**
 * Flattens nested arrays.
 */
function arrayFlatten(array, depth = -1) {
    var result = [];
    for (var item in array) {
        if (isArray(item) && depth != 0) {
            var sub = arrayFlatten(item, depth - 1);
            for (var s in sub) {
                arrayAppend(result, s);
            }
        } else {
            arrayAppend(result, item);
        }
    }
    return result;
}

/**
 * Maps then flattens one level.
 */
function arrayFlatMap(array, callback) {
    return arrayFlatten(arrayMap(array, callback), 1);
}

/**
 * Returns array of 1-based indices where value matches.
 */
function arrayFindAll(array, value) {
    var result = [];
    var length = len(array);
    for (var i = 1; i <= length; i++) {
        var matches = false;
        if (_arrayIsCallback(value)) {
            matches = value(array[i], i);
        } else {
            matches = _arrayValueEquals(array[i], value);
        }
        if (matches) {
            arrayAppend(result, i);
        }
    }
    return result;
}

/**
 * Returns array indices matching a value without folding string case.
 */
function arrayFindAllNoCase(array, value) {
    var result = [];
    var length = len(array);
    for (var i = 1; i <= length; i++) {
        if (_arrayValueEqualsNoCase(array[i], value)) {
            arrayAppend(result, i);
        }
    }
    return result;
}

/**
 * Returns the first element matching the callback.
 */
function arrayFindFirst(array, callback, defaultValue) {
    for (var item in array) {
        if (callback(item)) {
            return item;
        }
    }
    if (!isNull(defaultValue)) {
        return defaultValue;
    }
    throw "arrayFindFirst() no element found and no default provided";
}

/**
 * Reduces from right to left.
 */
function arrayReduceRight(array, callback, initialValue) {
    var result = initialValue;
    var length = len(array);
    for (var i = length; i >= 1; i--) {
        result = callback(result, array[i]);
    }
    return result;
}

/**
 * Returns elements that do NOT match the predicate.
 */
function arrayReject(array, predicate) {
    var result = [];
    for (var item in array) {
        if (!predicate(item)) {
            arrayAppend(result, item);
        }
    }
    return result;
}

/**
 * Converts array to struct with 1-based numeric keys.
 */
function arrayToStruct(array) {
    var result = {};
    var length = len(array);
    for (var i = 1; i <= length; i++) {
        structInsert(result, toString(i), array[i]);
    }
    return result;
}

/**
 * Returns the median value of a numeric array.
 */
function arrayMedian(array) {
    var length = len(array);
    if (length == 0) {
        return 0;
    }
    var sorted = [];
    for (var item in array) {
        arrayAppend(sorted, item);
    }
    arraySort(sorted, "numeric", "asc");
    var mid = int(length / 2);
    if (length % 2 == 1) {
        return sorted[mid + 1];
    }
    return (sorted[mid] + sorted[mid + 1]) / 2;
}

/**
 * Groups array elements by callback result.
 */
function arrayGroupBy(array, callback) {
    var result = {};
    var length = len(array);
    for (var i = 1; i <= length; i++) {
        var key = toString(callback(array[i]));
        if (!structKeyExists(result, key)) {
            structInsert(result, key, []);
        }
        arrayAppend(result[key], array[i]);
    }
    return result;
}

/**
 * Transposes a 2D array (rows become columns).
 */
function arrayTranspose(array) {
    var rows = len(array);
    if (rows == 0) {
        return [];
    }
    var cols = len(array[1]);
    if (cols == 0) {
        return [];
    }
    var result = [];
    for (var c = 1; c <= cols; c++) {
        var row = [];
        for (var r = 1; r <= rows; r++) {
            arrayAppend(row, array[r][c]);
        }
        arrayAppend(result, row);
    }
    return result;
}

/**
 * Zips two arrays into an array of pairs.
 */
function arrayZip(array1, array2, callback) {
    var len1 = len(array1);
    var len2 = len(array2);
    if (len1 != len2) {
        throw "arrayZip() arrays must be the same length";
    }
    var result = [];
    for (var i = 1; i <= len1; i++) {
        if (!isNull(callback)) {
            arrayAppend(result, callback(array1[i], array2[i]));
        } else {
            var pair = [];
            arrayAppend(pair, array1[i]);
            arrayAppend(pair, array2[i]);
            arrayAppend(result, pair);
        }
    }
    return result;
}

/**
 * Removes/replaces elements in an array and returns the removed elements.
 */
function arraySplice(array, index, deleteCount = 0, replacements) {
    var len_arr = len(array);
    var start = index;
    if (start < 0) {
        start = len_arr + start + 1;
    }
    if (start < 1) {
        start = 1;
    }
    if (start > len_arr + 1) {
        start = len_arr + 1;
    }
    var dc = deleteCount;
    if (dc < 0) {
        dc = 0;
    }
    var removed = [];
    for (var d = 0; d < dc; d++) {
        if (start <= len(array)) {
            arrayAppend(removed, array[start]);
            arrayDeleteAt(array, start);
        }
    }
    if (!isNull(replacements)) {
        var rLen = len(replacements);
        for (var r = 1; r <= rLen; r++) {
            arrayInsertAt(array, start + r - 1, replacements[r]);
        }
    }
    return removed;
}

/**
 * Returns basic array metadata.
 */
function arrayGetMetadata(array) {
    var arrayType = "synchronized";
    if (!arrayIsSynchronized(array)) {
        arrayType = "unsynchronized";
    }
    return { "type": arrayType, "datatype": "any", "dimensions": 1 };
}

/**
 * Stable comparison helper for arraySort / structSort.
 *
 * Returns true when `a` should be emitted before `b` during a merge pass.
 * Uses `<=` / `>=` (never strict `<` / `>`) so that equal elements keep the
 * left-hand (earlier) position — this is what makes the merge sort stable,
 * matching the previous bubble sort, which only swapped on strict
 * inequality. The VM's `<=` / `>=` operators share the same
 * number/datetime/string fallback as `<` / `>`, so ordering is preserved
 * for every value type.
 */
function _sortShouldComeBefore(a, b, sortType, sortOrder) {
    if (_arrayIsCallback(sortType)) {
        return sortType(a, b) <= 0;
    }
    if (sortType == "textnocase") {
        if (sortOrder == "asc") {
            return compare(lcase(a), lcase(b)) <= 0;
        }
        return compare(lcase(a), lcase(b)) >= 0;
    }
    if (sortType == "text") {
        if (sortOrder == "asc") {
            return compare(toString(a), toString(b)) <= 0;
        }
        return compare(toString(a), toString(b)) >= 0;
    }
    if (sortOrder == "asc") {
        return a <= b;
    }
    return a >= b;
}

function _arrayIsCallback(value) {
    return isClosure(value) || isCustomFunction(value);
}

function _arrayValueEquals(left, right) {
    if (isString(left) && isString(right)) {
        return compare(left, right) == 0;
    }
    return left == right;
}

function _arrayValueEqualsNoCase(left, right) {
    if (isString(left) && isString(right)) {
        return compare(lcase(left), lcase(right)) == 0;
    }
    return left == right;
}

// --- Struct BIFs ---

/**
 * Appends properties from one struct to another.
 */
function structAppend(target, source, overwrite = true) {
    var keys = structKeyArray(source);
    for (key in keys) {
        if (overwrite) {
            structUpdate(target, key, source[key]);
        } else if (!structKeyExists(target, key)) {
            structInsert(target, key, source[key]);
        }
    }
    return true;
}

/**
 * Returns a shallow copy of a struct.
 */
function structCopy(struct) {
    var result = {};
    structAppend(result, struct);
    return result;
}

/**
 * Iterates over a struct and calls a callback for each key-value pair.
 */
function structEach(struct, callback) {
    var keys = structKeyArray(struct);
    for (key in keys) {
        callback(key, struct[key], struct);
    }
}

/**
 * Maps a struct to a new struct using a callback function.
 */
function structMap(struct, callback) {
    var result = {};
    var keys = structKeyArray(struct);
    for (key in keys) {
        structInsert(result, key, callback(key, struct[key], struct));
    }
    return result;
}

/**
 * Filters a struct based on a predicate function.
 */
function structFilter(struct, predicate) {
    var result = {};
    var keys = structKeyArray(struct);
    for (key in keys) {
        if (predicate(key, struct[key], struct)) {
            structInsert(result, key, struct[key]);
        }
    }
    return result;
}

/**
 * Reduces a struct to a single value using an accumulator function.
 */
function structReduce(struct, callback, initialValue) {
    var result = initialValue;
    var keys = structKeyArray(struct);
    for (key in keys) {
        result = callback(result, key, struct[key], struct);
    }
    return result;
}

/**
 * Determines if every element in a struct satisfies a condition.
 */
function structEvery(struct, callback) {
    var keys = structKeyArray(struct);
    for (key in keys) {
        if (!callback(key, struct[key], struct)) {
            return false;
        }
    }
    return true;
}

/**
 * Determines if at least one element in a struct satisfies a condition.
 */
function structSome(struct, callback) {
    var keys = structKeyArray(struct);
    for (key in keys) {
        if (callback(key, struct[key], struct)) {
            return true;
        }
    }
    return false;
}

/**
 * Determines if no elements in a struct satisfy a condition.
 */
function structNone(struct, callback) {
    return !structSome(struct, callback);
}

/**
 * Returns an array of values in a struct.
 */
function structValueArray(struct) {
    var result = [];
    var keys = structKeyArray(struct);
    for (key in keys) {
        arrayAppend(result, struct[key]);
    }
    return result;
}

/**
 * Returns a delimited list of keys in a struct.
 */
function structKeyList(struct, delimiter = ",") {
    return arrayToList(structKeyArray(struct), delimiter);
}

/**
 * Finds a key in a struct by value.
 */
function structFindValue(struct, value, scope = "one") {
    var result = [];
    var keys = structKeyArray(struct);
    for (key in keys) {
        if (struct[key] == value) {
            var match = { "key": key, "path": "." & key, "value": struct[key] };
            arrayAppend(result, match);
            if (scope != "all") {
                return result;
            }
        }
    }
    return result;
}

/**
 * Sorts struct keys and returns them as an array, ordered by the value each
 * key maps to. Uses an O(n log n) stable merge sort operating on the key
 * array; values are looked up by key during comparison so semantics match
 * the previous bubble-sort implementation.
 */
function _structSortValue(struct, key, path) {
    var value = struct[key];
    if (isNull(path) || path == "") {
        return value;
    }
    var pathParts = listToArray(path, ".");
    for (var part in pathParts) {
        if (!isStruct(value) || !structKeyExists(value, part)) {
            return null;
        }
        value = value[part];
    }
    return value;
}

function structSort(struct, sortType = "text", sortOrder = "asc", path = "", callback = null) {
    var keys = structKeyArray(struct);
    var length = len(keys);
    if (length < 2) {
        return keys;
    }

    if (_arrayIsCallback(sortType)) {
        callback = sortType;
    }

    var work = arraySlice(keys, 1, length);
    var width = 1;
    while (width < length) {
        var merged = [];
        var i = 1;
        var doubledWidth = width * 2;
        while (i <= length) {
            var leftEnd = i + width - 1;
            if (leftEnd > length) {
                leftEnd = length;
            }
            var rightStart = leftEnd + 1;
            var rightEnd = rightStart + width - 1;
            if (rightEnd > length) {
                rightEnd = length;
            }

            if (rightStart > length) {
                for (var k = i; k <= leftEnd; k++) {
                    arrayAppend(merged, work[k]);
                }
            } else {
                var l = i;
                var r = rightStart;
                while (l <= leftEnd && r <= rightEnd) {
                    var comesBefore = false;
                    if (!isNull(callback)) {
                        comesBefore = callback(work[l], work[r]) <= 0;
                    } else {
                        var leftValue = work[l];
                        var rightValue = work[r];
                        if (sortType != "text" || path != "") {
                            leftValue = _structSortValue(struct, work[l], path);
                            rightValue = _structSortValue(struct, work[r], path);
                        } else {
                            leftValue = work[l];
                            rightValue = work[r];
                        }
                        comesBefore = _sortShouldComeBefore(leftValue, rightValue, sortType, sortOrder);
                    }
                    if (comesBefore) {
                        arrayAppend(merged, work[l]);
                        l = l + 1;
                    } else {
                        arrayAppend(merged, work[r]);
                        r = r + 1;
                    }
                }
                while (l <= leftEnd) {
                    arrayAppend(merged, work[l]);
                    l = l + 1;
                }
                while (r <= rightEnd) {
                    arrayAppend(merged, work[r]);
                    r = r + 1;
                }
            }
            i = i + doubledWidth;
        }
        work = merged;
        width = doubledWidth;
    }
    return work;
}

// --- Destructuring ---

/**
 * Elements of an array from position `from` on (the `...rest` of `[ a, ...rest ] = source`).
 */
function _destructureArrayRest(source, from) {
    var result = [];
    var size = len(source);
    for (var i = from; i <= size; i++) {
        arrayAppend(result, source[i]);
    }
    return result;
}

/**
 * Struct with every key of `source` that is not in `used` (the `...rest` of `{ a, ...rest } = source`).
 */
function _destructureObjectRest(source, used) {
    var result = {};
    for (key in structKeyArray(source)) {
        if (!arrayContainsNoCase(used, key)) {
            result[key] = source[key];
        }
    }
    return result;
}
