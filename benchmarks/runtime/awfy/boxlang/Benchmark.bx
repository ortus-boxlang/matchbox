class {
    function innerBenchmarkLoop(innerIterations) {
        for (var i = 0; i < innerIterations; i = i + 1) {
            if (!verifyResult(benchmark())) {
                return false;
            }
        }
        return true;
    }

    function benchmark() {
        throw "subclass responsibility";
    }

    function verifyResult(result) {
        throw "subclass responsibility";
    }
}
