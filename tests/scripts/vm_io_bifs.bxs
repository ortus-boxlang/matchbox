// ============================================================
// getDirectoryFromPath
// ============================================================
var result = getDirectoryFromPath("/foo/bar/baz.txt");
if (result != "/foo/bar/") { throw "getDirectoryFromPath failed: expected '/foo/bar/', got '" & result & "'"; }

result = getDirectoryFromPath("/foo/bar/");
if (result != "/foo/bar/") { throw "getDirectoryFromPath trailing slash failed: got '" & result & "'"; }

result = getDirectoryFromPath("filename.txt");
if (result != "/") { throw "getDirectoryFromPath no dir failed: got '" & result & "'"; }

// ============================================================
// expandPath
// ============================================================
result = expandPath(".");
if (len(result) < 1) { throw "expandPath dot failed"; }

// ============================================================
// getCanonicalPath
// ============================================================
result = getCanonicalPath(".");
if (len(result) < 1) { throw "getCanonicalPath failed"; }

// ============================================================
// createTempFile
// ============================================================
var tmpFile = createTempFile(".", "test_", ".txt");
if (len(tmpFile) < 1) { throw "createTempFile failed"; }
if (!fileExists(tmpFile)) { throw "createTempFile file should exist"; }
fileDelete(tmpFile);

var exclusiveFile = createTempFile("/tmp", "matchbox-exclusive-", ".txt");
fileDelete(exclusiveFile);
fileWriteExclusive(exclusiveFile, "first", "0600");
var exclusiveRejected = false;
try {
    fileWriteExclusive(exclusiveFile, "second", "0600");
} catch (error) {
    exclusiveRejected = true;
}
if (!exclusiveRejected) { throw "fileWriteExclusive should reject an existing path"; }
if (fileRead(exclusiveFile) != "first") { throw "fileWriteExclusive overwrote an existing file"; }
fileDelete(exclusiveFile);

var publishSource = createTempFile("/tmp", "matchbox-publish-", ".txt");
var publishTarget = publishSource & ".published";
fileWrite(publishSource, "complete");
filePublishExclusive(publishSource, publishTarget);
if (fileExists(publishSource)) { throw "filePublishExclusive should remove the source name"; }
if (fileRead(publishTarget) != "complete") { throw "filePublishExclusive content mismatch"; }
var publishRejected = false;
var secondSource = createTempFile("/tmp", "matchbox-publish-", ".txt");
try {
    filePublishExclusive(secondSource, publishTarget);
} catch (error) {
    publishRejected = true;
}
if (!publishRejected) { throw "filePublishExclusive should reject an existing target"; }
if (!fileExists(secondSource)) { throw "filePublishExclusive should preserve a rejected source"; }
fileDelete(secondSource);
fileDelete(publishTarget);

// A failed replacement must not delete the destination.
var moveTarget = createTempFile("/tmp", "matchbox-move-", ".txt");
var moveFailed = false;
try {
    fileWrite(moveTarget, "original");
    try { fileMove(moveTarget & ".missing", moveTarget); } catch (error) { moveFailed = true; }
    if (!moveFailed || !fileExists(moveTarget) || fileRead(moveTarget) != "original") { throw "Failed fileMove destroyed the destination"; }
    var moveSource = createTempFile("/tmp", "matchbox-move-", ".txt");
    fileWrite(moveSource, "replacement");
    fileMove(moveSource, moveTarget);
    if (fileExists(moveSource) || fileRead(moveTarget) != "replacement") { throw "fileMove replacement failed"; }
} finally { if (fileExists(moveTarget)) { fileDelete(moveTarget); } }

var rejectedTempTraversal = false;
try {
    createTempFile("/tmp", "../escape", ".txt");
} catch (error) {
    rejectedTempTraversal = true;
}
if (!rejectedTempTraversal) { throw "createTempFile should reject path traversal"; }

// ============================================================
// createTempDirectory
// ============================================================
var tmpDir = createTempDirectory(".", "testdir_");
if (len(tmpDir) < 1) { throw "createTempDirectory failed"; }
if (!directoryExists(tmpDir)) { throw "createTempDirectory dir should exist"; }
directoryDelete(tmpDir, false);

// ============================================================
// fileGetMimeType
// ============================================================
result = fileGetMimeType("test.html", false);
if (result != "text/html") { throw "fileGetMimeType html failed: got '" & result & "'"; }

result = fileGetMimeType("test.json", false);
if (result != "application/json") { throw "fileGetMimeType json failed: got '" & result & "'"; }

result = fileGetMimeType("test.unknown", false);
if (result != "application/octet-stream") { throw "fileGetMimeType unknown failed: got '" & result & "'"; }

// ============================================================
// directoryCopy
// ============================================================
var srcDir = "matchbox_test_dirCopy_src";
var dstDir = "matchbox_test_dirCopy_dst";
directoryCreate(srcDir, true);
fileWrite(srcDir & "/file1.txt", "hello");
directoryCopy(srcDir, dstDir, true);
if (!fileExists(dstDir & "/file1.txt")) { throw "directoryCopy failed: file not copied"; }
var content = fileRead(dstDir & "/file1.txt");
if (content != "hello") { throw "directoryCopy content mismatch"; }
directoryDelete(srcDir, true);
directoryDelete(dstDir, true);

// ============================================================
// directoryMove
// ============================================================
var moveSrc = "matchbox_test_dirMove_src";
var moveDst = "matchbox_test_dirMove_dst";
directoryCreate(moveSrc, true);
fileWrite(moveSrc & "/file1.txt", "world");
directoryMove(moveSrc, moveDst);
if (directoryExists(moveSrc)) { throw "directoryMove: source should not exist"; }
if (!fileExists(moveDst & "/file1.txt")) { throw "directoryMove: file not moved"; }
directoryDelete(moveDst, true);

// ============================================================
// propertyFile
// ============================================================
var propPath = "matchbox_test.properties";
fileWrite(propPath, "key1=value1" & chr(10) & "key2=value2" & chr(10) & "key3=value3");
var props = propertyFile(propPath);
if (props.key1 != "value1") { throw "propertyFile key1 failed: got '" & props.key1 & "'"; }
if (props.key2 != "value2") { throw "propertyFile key2 failed: got '" & props.key2 & "'"; }
if (props.key3 != "value3") { throw "propertyFile key3 failed"; }
fileDelete(propPath);

// ============================================================
// contractPath
// ============================================================
result = contractPath(expandPath("."));
if (result != ".") { throw "contractPath round-trip failed: got '" & result & "'"; }
