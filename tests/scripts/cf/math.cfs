// CFScript syntax added for issue #45, checked with assert.

x = 10 MOD 3;
assert x == 1 : "MOD works like %";

assert NOT false : "NOT works like !";
assert 5 GT 3 AND 2 LTE 2 : "word comparison operators";

s = { a = 1, b = 2 };
assert s.a + s.b == 3 : "struct literal with =";

function double(n) output=false {
    return n * 2;
}
assert double(4) == 8 : "function with an output attribute";

total = 0;
for (i = 1; i <= 4; i++) {
    total += i;
}
assert total == 10 : "for loop";

// getTemplatePath() is CF's name; the rename pass turns it into
// getBaseTemplatePath(), which MatchBox implements.
assert isString(getTemplatePath()) : "getTemplatePath is renamed";
