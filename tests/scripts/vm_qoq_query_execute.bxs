// QoQ queryExecute integration smoke test.

employees = queryNew(["id", "name", "dept"])

row = {}
row.id = 1
row.name = "Alice"
row.dept = "Sales"
queryAddRow(employees, row)

row = {}
row.id = 2
row.name = "Bob"
row.dept = "Engineering"
queryAddRow(employees, row)

result = queryExecute(
    "SELECT name, dept FROM employees ORDER BY id",
    null,
    {dbType: "query"}
)

if (result.recordCount != 2) {
    throw "Expected QoQ result to return 2 rows, got: " & result.recordCount
}

names = queryColumnData(result, "name")
if (names[1] != "Alice") {
    throw "Expected first QoQ row name to be Alice, got: " & names[1]
}
if (names[2] != "Bob") {
    throw "Expected second QoQ row name to be Bob, got: " & names[2]
}

depts = queryColumnData(result, "dept")
if (depts[1] != "Sales") {
    throw "Expected first QoQ row dept to be Sales, got: " & depts[1]
}
if (depts[2] != "Engineering") {
    throw "Expected second QoQ row dept to be Engineering, got: " & depts[2]
}

company = {}
company.catalog = {}
company.catalog.people = employees

nested = queryExecute(
    "SELECT name FROM variables.company.catalog.people ORDER BY id",
    null,
    {dbType: "query", returnType: "array"}
)

if (len(nested) != 2) {
    throw "Expected nested QoQ array return to have 2 rows, got: " & len(nested)
}

if (nested[1].name != "Alice") {
    throw "Expected nested QoQ row 1 name to be Alice, got: " & nested[1].name
}

if (nested[2].name != "Bob") {
    throw "Expected nested QoQ row 2 name to be Bob, got: " & nested[2].name
}

positional = arrayNew()
arrayAppend(positional, 2)

positionalResult = queryExecute(
    "SELECT name FROM employees WHERE id = ?",
    positional,
    {dbType: "query"}
)

if (positionalResult.recordCount != 1) {
    throw "Expected positional QoQ query to return 1 row, got: " & positionalResult.recordCount
}

positionalNames = queryColumnData(positionalResult, "name")
if (positionalNames[1] != "Bob") {
    throw "Expected positional QoQ query to match Bob, got: " & positionalNames[1]
}

named = {}
named.id = {}
named.id.value = 1
named.id.cfsqltype = "CF_SQL_INTEGER"

namedResult = queryExecute(
    "SELECT name FROM employees WHERE id = :id",
    named,
    {dbType: "query"}
)

if (namedResult.recordCount != 1) {
    throw "Expected named QoQ query to return 1 row, got: " & namedResult.recordCount
}

namedNames = queryColumnData(namedResult, "name")
if (namedNames[1] != "Alice") {
    throw "Expected named QoQ query to match Alice, got: " & namedNames[1]
}

// Use the same expanded SQL/parameter sequence as ordinary datasource queries.
options = {dbtype: "query"};
repeated = queryExecute(
    "SELECT name FROM employees WHERE id=:ID OR id=:id",
    [{name: "id", value: 1, cfsqltype: "CF_SQL_INTEGER"}], options
);
assert repeated.recordCount == 1;
assert queryColumnData(repeated, "name")[1] == "Alice";

namedList = queryExecute(
    "SELECT :ids FROM employees WHERE id=1",
    {ids: {value: "1,2", list: true, cfsqltype: "CF_SQL_INTEGER"}}, options
);
assert namedList.recordCount == 1;
columns = queryColumnArray(namedList);
assert len(columns) == 2;
assert queryColumnData(namedList, columns[1])[1] == 1;
assert queryColumnData(namedList, columns[2])[1] == 2;

positionalList = queryExecute(
    "SELECT ? FROM employees WHERE id=1",
    [{value: [1,2], list: true, cfsqltype: "CF_SQL_INTEGER"}], options
);
assert positionalList.recordCount == 1;
columns = queryColumnArray(positionalList);
assert len(columns) == 2;
assert queryColumnData(positionalList, columns[1])[1] == 1;
assert queryColumnData(positionalList, columns[2])[1] == 2;

quoted = queryExecute(
    "SELECT ':id ?' AS note FROM employees WHERE id=:id", {id: 1}, options
);
assert queryColumnData(quoted, "note")[1] == ":id ?";
escaped = queryExecute("SELECT 'O''Brien' AS note FROM employees WHERE id=1", null, options);
assert queryColumnData(escaped, "note")[1] == "O'Brien";
bound = queryExecute("SELECT :note AS note FROM employees WHERE id=1", {note: "'quoted' :id ?"}, options);
assert queryColumnData(bound, "note")[1] == "'quoted' :id ?";

missing = false;
try { queryExecute("SELECT name FROM employees WHERE id=:missing", {}, options); }
catch (e) { missing = true; }
assert missing;

println("vm_qoq_query_execute: OK")
