diagnostic = { "errors" = [ { "message" = "offline" }, ], "count": 1 };
assert diagnostic.errors.len() == 1 && diagnostic.errors[1].message == "offline";

// Test struct member assignment
s = {}
s.x = 10
println("s.x = ", s.x)

s["y"] = 20
println("s.y = ", s.y)

nested = { inner: {} }
nested.inner.val = 30
println("nested.inner.val = ", nested.inner.val)
