// `break` out of a C-style for loop must leave the stack as the normal loop exit does: before the fix the loop variable
// stayed on the stack and every local declared after the loop was shifted ("Member access only supported on structs").
function check( label, got, want ) {
    if ( got != want ) throw( "FAIL " & label & ": got [" & got & "] wanted [" & want & "]" );
}

function breakThenLocals() {
    for ( var i = 1; i <= 3; i++ ) { if ( i == 2 ) break; }
    var inn = { label: "L" };
    var out = inn.label;
    return out;
}
check( "locals after a break", breakThenLocals(), "L" );

function breakInsideIf() {
    var steps = [];
    if ( true ) {
        for ( var n = 1; n <= 25; n++ ) { if ( n == 2 ) break; steps.append( n ); }
        var info = { argv: [ "a", "b" ] };
        steps.append( info.argv.len() );
    }
    var last = { done: "yes" };
    return steps.toList( "," ) & ":" & last.done;
}
check( "break inside an if block", breakInsideIf(), "1,2:yes" );

function nestedBreak() {
    var rows = [];
    for ( var a = 1; a <= 2; a++ ) {
        for ( var b = 1; b <= 3; b++ ) {
            if ( b == 2 ) break;
            rows.append( a & ":" & b );
        }
        var tag = { v: a };
        rows.append( "t" & tag.v );
    }
    return rows.toList( "," );
}
check( "nested classic loops with break", nestedBreak(), "1:1,t1,2:1,t2" );

function noBreakStillFine() {
    var total = 0;
    for ( var k = 1; k <= 3; k++ ) { total += k; }
    var z = { t: total };
    return z.t;
}
check( "a loop without break", noBreakStillFine(), 6 );

function whileUnchanged() {
    var i = 0;
    while ( i < 5 ) { i++; if ( i == 2 ) break; }
    var q = { i: i };
    return q.i;
}
check( "while with break", whileUnchanged(), 2 );
println( "ok" );
