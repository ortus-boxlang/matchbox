// Test string interpolation
name = "BoxLang"
ver = 1.0
message = "Welcome to #name# version #ver#"
println(message)

// Escaped hashes
escaped = "This is a literal ##hash mark"
println(escaped)

// Expressions in interpolation
println("The result of 10 + 20 is #10 + 20#")

// Nested interpolation? (Usually works)
person = {
    firstName: "Luis",
    lastName: "Majano"
}
println("CEO: #person.firstName# #person.lastName#")

// Interpolation in single quotes
single = 'Hello #name#'
println(single)

usage = { prompt_tokens: 17 };
function echoUsage(text) { return text; }
assert echoUsage("Prompt=#usage.keyExists( "prompt_tokens" ) ? usage.prompt_tokens : 0#") == "Prompt=17";
assert echoUsage('Missing=#usage.keyExists( '' ) ? 1 : 0#') == 'Missing=0';
assert echoUsage("#ver##name#") == "1BoxLang";
