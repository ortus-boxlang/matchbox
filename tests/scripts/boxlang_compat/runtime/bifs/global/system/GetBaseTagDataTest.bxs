// boxlang_compat: ortus/boxlang/runtime/bifs/global/system/GetBaseTagDataTest.java
// Missing custom tags throw on the canonical JVM; do not accept a null placeholder.
rejected = false;
try { getBaseTagData( "missingTag" ); } catch(any error) { rejected = findNoCase("not found", error.message) > 0; }
assert rejected : "testGetTagData missing-tag";
