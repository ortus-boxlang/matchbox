// boxlang_compat: ortus/boxlang/runtime/bifs/global/io/FileReadLineTest.java
p = createTempFile();
fileWrite( p, "box" & chr( 10 ) & "lang" & chr( 10 ) & "rocks!" );
result = fileReadLine( p );
assert result == "box" : "testFileReadLine path";
fileDelete( p );

p = createTempFile();
fileWrite( p, "box" & chr( 10 ) & "lang" & chr( 13 ) & chr( 10 ) & "rocks!" );
f = fileOpen( p );
assert fileReadLine( f ) == "box" : "testFileReadLine first";
assert fileReadLine( f ) == "lang" : "testFileReadLine second";
assert fileReadLine( f ) == "rocks!" : "testFileReadLine third";
assert isNull( fileReadLine( f ) ) : "testFileReadLine end-is-null";
fileClose( f );

f = fileOpen( p );
assert f.readLine() == "box" : "testReadLineMember first";
assert f.readLine() == "lang" : "testReadLineMember second";
f.close();

threw = false;
try {
    fileReadLine( f );
} catch ( e ) {
    threw = true;
}
assert threw : "testReadLineAfterClose";

w = fileOpen( p, "write" );
threw = false;
try {
    fileReadLine( w );
} catch ( e ) {
    threw = true;
}
assert threw : "testWriteFileError";
fileClose( w );
fileDelete( p );
