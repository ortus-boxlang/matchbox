// boxlang_compat: ortus/boxlang/runtime/bifs/global/io/SymlinkTest.java
// Symbolic links need OS support. Systems that cannot create links skip these tests in the JVM suite.
root = createTempDirectory();
outside = root & "/outside";
directoryCreate( outside & "/deep", true );
fileWrite( outside & "/keep.txt", "keep" );
fileWrite( outside & "/deep/inner.txt", "inner" );

// testCreateIsRead
created = fileCreateSymlink( root & "/current", outside );
assert fileIsSymlink( root & "/current" ) : "testCreateIsRead isLink";
assert !fileIsSymlink( outside & "/keep.txt" ) : "testCreateIsRead notLink";
assert !fileIsSymlink( root & "/nope" ) : "testCreateIsRead missing";
assert fileReadSymlink( root & "/current" ) == outside : "testCreateIsRead target";
assert findNoCase( "current", created ) > 0 : "testCreateIsRead returns link path";

// testReadRelativeTarget
fileCreateSymlink( root & "/rel", "outside" );
assert fileReadSymlink( root & "/rel" ) == "outside" : "testReadRelativeTarget stored";
assert fileReadSymlink( path = root & "/rel", resolve = true ) == outside : "testReadRelativeTarget resolved";

// testDanglingLink
fileCreateSymlink( root & "/dangling", root & "/does-not-exist" );
assert fileIsSymlink( root & "/dangling" ) : "testDanglingLink";

// testReadNonLink
threw = false;
try {
	fileReadSymlink( outside & "/keep.txt" );
} catch ( any e ) {
	threw = true;
}
assert threw : "testReadNonLink";

// testOverwrite
threw = false;
try {
	fileCreateSymlink( root & "/current", root );
} catch ( any e ) {
	threw = true;
}
assert threw : "testOverwrite throws without overwrite";
fileCreateSymlink( root & "/current", root, true );
assert fileReadSymlink( root & "/current" ) == root : "testOverwrite replaced";

// testOverwriteDirectory
threw = false;
try {
	fileCreateSymlink( outside, root, true );
} catch ( any e ) {
	threw = true;
}
assert threw : "testOverwriteDirectory throws";
assert directoryExists( outside ) && !fileIsSymlink( outside ) : "testOverwriteDirectory kept directory";

// testFileInfo
fileCreateSymlink( root & "/info", outside );
info = fileInfo( root & "/info" );
assert info.isLink == true : "testFileInfo isLink";
assert info.linkTarget == outside : "testFileInfo linkTarget";
assert info.is_symlink == true : "testFileInfo is_symlink alias";
assert info.target == outside : "testFileInfo target alias";
info = fileInfo( outside & "/keep.txt" );
assert info.isLink == false : "testFileInfo file isLink";
assert info.linkTarget == "" : "testFileInfo file linkTarget";
info = getFileInfo( root & "/info" );
assert info.isLink == true : "testGetFileInfo isLink";

// testDeleteNestedLink
tree = root & "/tree";
directoryCreate( tree );
fileWrite( tree & "/a.txt", "a" );
fileCreateSymlink( tree & "/lnk", outside );
directoryDelete( tree, true );
assert !directoryExists( tree ) : "testDeleteNestedLink tree removed";
assert fileExists( outside & "/keep.txt" ) : "testDeleteNestedLink keep";
assert fileExists( outside & "/deep/inner.txt" ) : "testDeleteNestedLink inner";

// testDeleteTopLevelLink
fileCreateSymlink( root & "/toplink", outside );
directoryDelete( root & "/toplink", true );
assert !fileIsSymlink( root & "/toplink" ) : "testDeleteTopLevelLink link removed";
assert fileExists( outside & "/keep.txt" ) : "testDeleteTopLevelLink keep";

// testDeleteFileAndDanglingLinks
tree = root & "/tree2";
directoryCreate( tree );
fileCreateSymlink( tree & "/fileLink", outside & "/keep.txt" );
fileCreateSymlink( tree & "/dangling", root & "/nope" );
directoryDelete( tree, true );
assert !directoryExists( tree ) : "testDeleteFileAndDanglingLinks tree removed";
assert fileExists( outside & "/keep.txt" ) : "testDeleteFileAndDanglingLinks keep";

// testListFollowLinks
tree = root & "/tree3";
directoryCreate( tree );
fileWrite( tree & "/a.txt", "a" );
fileCreateSymlink( tree & "/lnk", outside );
r = directoryList( tree, true, "name" );
assert arrayLen( r ) == 2 : "testListFollowLinks does not descend";
r = directoryList( tree, true, "name", "*", "name", "all", true );
assert arrayContains( r, "keep.txt" ) : "testListFollowLinks follows keep";
assert arrayContains( r, "inner.txt" ) : "testListFollowLinks follows inner";

// testListTopLevelLink
fileCreateSymlink( root & "/toplist", outside );
r = directoryList( root & "/toplist", false, "name" );
assert arrayLen( r ) == 2 : "testListTopLevelLink count";
r = directoryList( root & "/toplist", false, "path" );
assert findNoCase( "toplist", r[ 1 ] ) > 0 : "testListTopLevelLink path";

// testListQueryColumns
q = directoryList( tree, false, "query", "*", "name" );
assert q.recordCount == 2 : "testListQueryColumns count";
assert q.isLink[ 1 ] == false : "testListQueryColumns file isLink";
assert q.linkTarget[ 1 ] == "" : "testListQueryColumns file target";
assert q.isLink[ 2 ] == true : "testListQueryColumns link isLink";
assert q.linkTarget[ 2 ] == outside : "testListQueryColumns link target";

// testCopyLinksAsLinks
dest = root & "/dest";
directoryCopy( tree, dest, true );
assert fileIsSymlink( dest & "/lnk" ) : "testCopyLinksAsLinks link";
assert fileReadSymlink( dest & "/lnk" ) == outside : "testCopyLinksAsLinks target";
assert fileExists( dest & "/a.txt" ) : "testCopyLinksAsLinks file";

// testCopyFollowLinks
dest = root & "/dest2";
directoryCopy( tree, dest, true, "*", true, false, true );
assert !fileIsSymlink( dest & "/lnk" ) : "testCopyFollowLinks real directory";
assert fileExists( dest & "/lnk/keep.txt" ) : "testCopyFollowLinks keep";
assert fileExists( dest & "/lnk/deep/inner.txt" ) : "testCopyFollowLinks inner";

// testDeleteFollowLinks (opt in, empties the target)
tree = root & "/tree4";
directoryCreate( tree );
fileCreateSymlink( tree & "/lnk", outside );
directoryDelete( tree, true, true );
assert !directoryExists( tree ) : "testDeleteFollowLinks tree removed";
assert !fileExists( outside & "/keep.txt" ) : "testDeleteFollowLinks emptied target";

directoryDelete( root, true );
