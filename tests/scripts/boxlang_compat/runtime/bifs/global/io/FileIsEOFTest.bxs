// boxlang_compat: ortus/boxlang/runtime/bifs/global/io/FileIsEOFTest.java
p = createTempFile();
fileWrite( p, "eof" );
threw = false;
try {
    fileIsEOF( p );
} catch ( e ) {
    threw = true;
}
assert threw : "testReadFileEOF path-requires-open-file";
fileDelete( p );

p = createTempFile();
fileWrite( p, "one" & chr( 10 ) & "two" );
f = fileOpen( p, "read", "utf-8", true );
assert fileIsEOF( f ) == false : "testReadFileEOF first";
for ( i = 1; i <= 100; i++ ) {
    f.readLine();
}
assert fileIsEOF( f ) : "testReadFileEOF last";
fileClose( f );

w = fileOpen( p, "write" );
threw = false;
try {
    fileIsEOF( w );
} catch ( e ) {
    threw = true;
}
assert threw : "testWriteFileEOF";
fileClose( w );

b = fileOpen( p, "readbinary" );
assert fileIsEOF( b ) == false : "testBinaryEOF first";
fileRead( b );
assert fileIsEOF( b ) : "testBinaryEOF last";
fileClose( b );
fileDelete( p );
