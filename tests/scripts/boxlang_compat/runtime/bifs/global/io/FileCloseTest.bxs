// boxlang_compat: ortus/boxlang/runtime/bifs/global/io/FileCloseTest.java
p = createTempFile();
fileWrite( p, "close file test" );
fileClose( p );
assert fileExists( p ) : "testBifWithInvalidFile path";
fileDelete( p );

p = createTempFile();
fileWrite( p, "close file test" );
f = fileOpen( p );
assert isNull( fileClose( f ) ) : "testFileCloseReturnsNull";
threw = false;
try {
    f.readLine();
} catch ( e ) {
    threw = true;
}
assert threw : "testReadAfterClose";
fileDelete( p );
